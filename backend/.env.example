# 이 폴더(backend/)에 .env(개발)와 .env.test(테스트)로 복사해 값을 채운다. 운영 값은 Vercel 환경변수에만 둔다.
# 시크릿(DATABASE_URL, JWT_SECRET)은 비워 두고, 나머지는 시크릿이 아닌 개발 기본값이다.
DATABASE_URL=
# HS384용 48바이트 이상 무작위 값 (예: openssl rand -base64 64)
JWT_SECRET=
# 프론트 출처 허용 목록(쉼표 구분, 경로·끝 '/' 없이). 개발은 Vite 개발 서버, 운영은 배포된 프론트 URL
CORS_ORIGINS=http://localhost:5173
# 인증 쿠키 SameSite: lax(기본, 프론트·API가 같은 사이트) | none(서로 다른 사이트, 예: 각자 *.vercel.app)
COOKIE_SAMESITE=lax
# 토큰 만료(선택, 1 이상 정수). 기본 액세스 15분, 리프레시 7일(갱신해도 연장 안 함)
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# 소셜 로그인(선택, 비우면 해당 경로는 404). APP_URL은 프론트 출처(기본: CORS_ORIGINS 첫 값), API_URL은 이 API의 공개 URL(기본 http://localhost:PORT)
# Google Redirect URI: {API_URL}/api/auth/oauth/google/callback
APP_URL=
API_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
